# Copy to .env and adjust. Never commit real secrets.
# Do NOT put secrets in NEXT_PUBLIC_* variables.

# PostgreSQL (local, staging ou produção):
DATABASE_URL="postgresql://nox:nox@localhost:5432/nox_os?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string"

ADMIN_EMAIL="admin@noxos.local"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

BRAND_NAME="NOX OS"
SELLER_NAME="[SEU NOME]"
DEFAULT_CITY="[SUA CIDADE/UF]"
LEAD_GOAL="1000"
INITIAL_RADIUS_KM="5"
MAX_RADIUS_KM="80"
PRIVACY_EMAIL="[SEU E-MAIL]"
PORTFOLIO_URL="[URL DO PORTFÓLIO]"
NOX_WHATSAPP="[SEU WHATSAPP]"

# true = seed cria “Dados de demonstração” (não entram como leads reais na meta)
DEMO_MODE="false"

# Futuro provedor comercial licenciado (stub)
# LICENSED_PLACES_API_URL=
# LICENSED_PLACES_API_KEY=

# --- Melhoria opcional com Claude (server-side) ---
# Defina ANTHROPIC_API_KEY apenas nas variáveis de ambiente da Vercel/servidor.
# Nunca use prefixo NEXT_PUBLIC_ e nunca versione a chave real.
# Sem esta chave, o gerador automático gratuito continua funcionando.
# ANTHROPIC_API_KEY="cole-a-chave-somente-no-painel-da-vercel"
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_MAX_TOKENS="8000"
# ANTHROPIC_TIMEOUT_MS="45000"
# DEMO_AI_HOURLY_LIMIT="20"

# --- Fotos ilustrativas licenciadas (server-side, opcional) ---
# Conta gratuita em https://www.pexels.com/api/. Sem esta chave, a demonstração
# é gerada com as composições visuais de sempre.
# PEXELS_API_KEY="cole-a-chave-somente-no-painel-da-vercel"
# PEXELS_TIMEOUT_MS="8000"
# Apenas para apontar a um mock local em desenvolvimento:
# PEXELS_API_URL="http://localhost:4020/v1/search"
