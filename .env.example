# Copy to .env and adjust. Never commit real secrets.
# Do NOT put secrets in NEXT_PUBLIC_* variables.

# PostgreSQL (local, staging ou produção):
DATABASE_URL="postgresql://nox:nox@localhost:5432/nox_os?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string"

ADMIN_EMAIL="admin@noxos.local"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

BRAND_NAME="NOX OS"
SELLER_NAME="[SEU NOME]"
DEFAULT_CITY="[SUA CIDADE/UF]"
LEAD_GOAL="1000"
INITIAL_RADIUS_KM="5"
MAX_RADIUS_KM="80"
PRIVACY_EMAIL="[SEU E-MAIL]"
PORTFOLIO_URL="[URL DO PORTFÓLIO]"
NOX_WHATSAPP="[SEU WHATSAPP]"

# true = seed cria “Dados de demonstração” (não entram como leads reais na meta)
DEMO_MODE="false"

# Compatibilidade temporária. Mantenha false para impedir novas DemoLanding.
ALLOW_LEGACY_DEMO_LANDING_CREATION="false"

# Futuro provedor comercial licenciado (stub)
# LICENSED_PLACES_API_URL=
# LICENSED_PLACES_API_KEY=

# --- Melhoria opcional com Claude (server-side) ---
# Defina ANTHROPIC_API_KEY apenas nas variáveis de ambiente da Vercel/servidor.
# Nunca use prefixo NEXT_PUBLIC_ e nunca versione a chave real.
# Sem esta chave, o gerador automático gratuito continua funcionando.
# ANTHROPIC_API_KEY="cole-a-chave-somente-no-painel-da-vercel"
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_MAX_TOKENS="8000"
# ANTHROPIC_TIMEOUT_MS="45000"
# DEMO_AI_HOURLY_LIMIT="20"

# --- Fotos ilustrativas licenciadas (server-side, opcional) ---
# Conta gratuita em https://www.pexels.com/api/. Sem esta chave, a demonstração
# é gerada com as composições visuais de sempre.
# PEXELS_API_KEY="cole-a-chave-somente-no-painel-da-vercel"
# PEXELS_TIMEOUT_MS="8000"
# Apenas para apontar a um mock local em desenvolvimento:
# PEXELS_API_URL="http://localhost:4020/v1/search"

# --- Fila durável e agendador ---
# O consumidor da fila é uma rota, não um worker: `GET /api/jobs/run` com
# `Authorization: Bearer <CRON_SECRET>`. Sem esta variável o agendador não
# funciona — e é assim de propósito. Tratar "não configurado" como "pode passar"
# transformaria uma variável esquecida num endpoint aberto, e variável esquecida
# é o erro de deploy mais comum que existe.
# Gere um valor longo e aleatório, e defina o MESMO valor no agendador
# (ver `infra/aws-cron/README.md`).
# CRON_SECRET=

# --- Integrações externas (Fase 3) ---
# Tudo nasce DESLIGADO. "disabled" força desligado para toda a instalação,
# acima do que estiver salvo no banco.
NOX_INTEGRATIONS="disabled"

# Nota para quem copiou este arquivo para `.env`: o Prisma carrega o `.env` ao
# inicializar, então esta variável chega ao processo de teste também. A suíte
# neutraliza o freio em `tests/setup/brake-off.ts`, para que `npm test` não
# dependa do que está no seu `.env` — e as suítes que testam o freio o ligam
# elas mesmas.

# Dois GitHub Apps, não um com dois escopos: criar repositório é a operação mais
# privilegiada da fábrica e fica isolada num App próprio.
# GITHUB_PROVISIONER_APP_ID=
# GITHUB_PROVISIONER_PRIVATE_KEY=
# GITHUB_RECONCILER_APP_ID=
# GITHUB_RECONCILER_PRIVATE_KEY=

# Organização do GitHub que contém apenas sites de cliente.
# NOX_SITES_ORG=

# VERCEL_TOKEN=

# Template e kit registrados no manifesto do site.
# NOX_SITE_TEMPLATE_OWNER="maikderick"
# NOX_SITE_TEMPLATE_REPO="nox-site-template"
# NOX_SITE_TEMPLATE_COMMIT=
# NOX_SITE_KIT_VERSION=
# NOX_SITE_KIT_SHA256=
