              "default": null
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "ogImage": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "CLIENTE",
                        "OPERADOR",
                        "BANCO_DE_IMAGENS"
                      ]
                    },
                    "license": {
                      "type": "string",
                      "enum": [
                        "PROPRIA",
                        "LICENCIADA"
                      ]
                    },
                    "credit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 180
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "creditUrl": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2048
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "width": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 10000
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "height": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 10000
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    }
                  },
                  "required": [
                    "src",
                    "alt",
                    "source",
                    "license"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "localBusinessType": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "LocalBusiness",
                    "ProfessionalService",
                    "Store",
                    "Restaurant",
                    "Bakery",
                    "CafeOrCoffeeShop",
                    "BeautySalon",
                    "HairSalon",
                    "HealthAndBeautyBusiness",
                    "MedicalClinic",
                    "Dentist",
                    "Physician",
                    "AutoRepair",
                    "LegalService",
                    "RealEstateAgent",
                    "HomeAndConstructionBusiness",
                    "Electrician",
                    "Plumber"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "locale": {
              "type": "string",
              "enum": [
                "pt_BR"
              ],
              "default": "pt_BR"
            }
          },
          "required": [
            "siteUrl",
            "defaultTitle",
            "description"
          ],
          "additionalProperties": false
        },
        "analytics": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "none",
                "ga4"
              ],
              "default": "none"
            },
            "measurementId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^G-[A-Z0-9]{4,20}$"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "consentMode": {
              "type": "string",
              "enum": [
                "required",
                "not_required"
              ],
              "default": "required"
            }
          },
          "additionalProperties": false
        },
        "privacy": {
          "type": "object",
          "properties": {
            "controllerName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "contactEmail": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 254,
                  "format": "email"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "body": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1500
                    },
                    "minItems": 1,
                    "maxItems": 10
                  }
                },
                "required": [
                  "heading",
                  "body"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "controllerName",
            "updatedAt",
            "sections"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "business",
        "contact",
        "about",
        "branding",
        "seo",
        "analytics",
        "privacy"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
