generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  role         String           @default("admin")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  notes        Note[]
  audits       AuditLog[]
  contacts     ContactAttempt[]
}

model Business {
  id               String   @id @default(cuid())
  externalId       String?
  source           String
  name             String
  nameNormalized   String
  category         String
  address          String?
  neighborhood     String?
  city             String?
  state            String?
  postalCode       String?
  country          String   @default("BR")
  latitude         Float?
  longitude        Float?
  distanceKm       Float?
  phoneRaw         String?
  phoneE164        String?
  website          String?
  websiteStatus    String   @default("unknown")
  socialLinks      String   @default("[]")
  sourceUrl        String?
  collectedAt      DateTime @default(now())
  lastVerifiedAt   DateTime @default(now())
  opportunityScore Int      @default(0)
  confidenceScore  Int      @default(0)
  scoreReasons     String   @default("[]")
  funnelStage      String   @default("novo")
  doNotContact     Boolean  @default(false)
  isDemo           Boolean  @default(false)
  notesText        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sources      BusinessSource[]
  scores       ScoreResult[]
  consents     ConsentRecord[]
  contacts     ContactAttempt[]
  notes        Note[]
  suppressions SuppressionEntry[]

  @@unique([source, externalId])
  @@index([city])
  @@index([category])
  @@index([opportunityScore])
  @@index([funnelStage])
  @@index([phoneE164])
  @@index([nameNormalized])
  @@index([distanceKm])
  @@index([doNotContact])
  @@index([isDemo])
  @@index([lastVerifiedAt])
}

model BusinessSource {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source      String
  externalId  String?
  fieldName   String
  fieldValue  String
  collectedAt DateTime @default(now())
  rawPayload  String?

  @@index([businessId])
  @@index([source, externalId])
}

model ImportJob {
  id              String    @id @default(cuid())
  provider        String
  status          String    @default("pending")
  originLat       Float?
  originLng       Float?
  originLabel     String?
  radiiKm         String    @default("[5,10,20,40,80]")
  currentRadiusKm Float?
  categories      String    @default("[]")
  progressJson    String    @default("{}")
  foundCount      Int       @default(0)
  acceptedCount   Int       @default(0)
  duplicateCount  Int       @default(0)
  rejectedCount   Int       @default(0)
  errorMessage    String?
  pausedAt        DateTime?
  cancelledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model ScoreResult {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunityScore Int
  confidenceScore  Int
  reasonsJson      String
  breakdownJson    String
  createdAt        DateTime @default(now())

  @@index([businessId])
}

model ConsentRecord {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  optInStatus String    @default("unknown")
  source      String?
  purpose     String?
  evidence    String?
  optedInAt   DateTime?
  refusedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([optInStatus])
}

model ContactAttempt {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  channel        String   @default("whatsapp")
  messagePreview String?
  confirmedSent  Boolean  @default(false)
  outcome        String?
  createdAt      DateTime @default(now())

  @@index([businessId])
}

model Note {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model SuppressionEntry {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  phoneE164  String?
  reason     String
  evidence   String?
  createdAt  DateTime  @default(now())

  @@index([phoneE164])
  @@index([businessId])
}

model AppSettings {
  id                String   @id @default("default")
  brandName         String   @default("NOX OS")
  sellerName        String   @default("[SEU NOME]")
  defaultCity       String   @default("[SUA CIDADE/UF]")
  leadGoal          Int      @default(1000)
  initialRadiusKm   Float    @default(5)
  maxRadiusKm       Float    @default(80)
  privacyEmail      String   @default("[SEU E-MAIL]")
  portfolioUrl      String   @default("[URL DO PORTFÓLIO]")
  whatsappPhone     String   @default("[SEU WHATSAPP]")
  whatsappTemplate  String   @default("Olá, equipe da {{businessName}}! Sou {{sellerName}}, da NOX OS. Conforme sua autorização para contato, gostaria de apresentar uma ideia de site personalizado para fortalecer a presença digital da empresa e gerar mais contatos. Posso te enviar uma proposta inicial sem compromisso? Se preferir não receber novas mensagens, é só me avisar.")
  originLat         Float?
  originLng         Float?
  originLabel       String?
  franchisePenalty  Int      @default(15)
  modernSitePenalty Int      @default(20)
  staleDataPenalty  Int      @default(10)
  enabledCategories String   @default("[]")
  retentionDays     Int      @default(365)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
